APP_LICENSE_NAME=MIT
APP_LICENSE_URL=https://github.com/DataRohit/InitStack/blob/master/license

DEBUG=true
ENVIRONMENT=development

HOST=0.0.0.0
PORT=8080
RELOAD=true

CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS","PATCH"]
CORS_ALLOW_HEADERS=["*"]

LOG_LEVEL=DEBUG
LOG_FORMAT=json

WORKERS=1

PROXY_HEADERS_ENABLED=true
PROXY_HEADERS_TRUSTED_HOSTS=["*"]

MAX_REQUEST_SIZE=16777216
MAX_UPLOAD_SIZE=104857600

CONSUL_ENABLED=true
CONSUL_HOST=initstack-consul-service
CONSUL_PORT=8500
CONSUL_TOKEN=Mx7nQ4wR8vK2sL9p
CONSUL_DATACENTER=dc1
CONSUL_SCHEME=http
CONSUL_VERIFY=true
CONSUL_SERVICE_NAME=initstack-fastapi-service
CONSUL_SERVICE_TAGS=["fastapi","api","web"]
CONSUL_HEALTH_CHECK_INTERVAL=10s
CONSUL_HEALTH_CHECK_TIMEOUT=5s
CONSUL_HEALTH_CHECK_DEREGISTER_CRITICAL_AFTER=30s

REDIS_ENABLED=true
