root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,rst,ini}]
indent_style = space
indent_size = 4

[*.{html,xml}]
indent_style = space
indent_size = 4

[*.{css,scss,less}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile,makefile]
indent_style = tab
tab_width = 4

[default.conf]
indent_style = space
indent_size = 4

[*.{sh,bash}]
indent_style = space
indent_size = 4

[Dockerfile*]
indent_style = space
indent_size = 4

[*.{bat,cmd,ps1}]
indent_style = space
indent_size = 4

[.editorconfig]
indent_style = space
indent_size = 4
