PROMETHEUS_VERSION=v3.8.1

PROMETHEUS_CONFIG_FILE=/etc/prometheus/prometheus.yml
PROMETHEUS_STORAGE_TSDB_PATH=/prometheus
PROMETHEUS_STORAGE_TSDB_RETENTION_TIME=30d
PROMETHEUS_STORAGE_TSDB_RETENTION_SIZE=50GB
PROMETHEUS_STORAGE_TSDB_WAL_COMPRESSION=true

PROMETHEUS_WEB_LISTEN_ADDRESS=0.0.0.0:9090
PROMETHEUS_WEB_EXTERNAL_URL=http://localhost:9090
PROMETHEUS_WEB_ROUTE_PREFIX=/
PROMETHEUS_WEB_ENABLE_LIFECYCLE=true
PROMETHEUS_WEB_ENABLE_ADMIN_API=true
PROMETHEUS_WEB_CONSOLE_TEMPLATES=/etc/prometheus/consoles
PROMETHEUS_WEB_CONSOLE_LIBRARIES=/etc/prometheus/console_libraries
PROMETHEUS_WEB_PAGE_TITLE=InitStack Prometheus
PROMETHEUS_WEB_CORS_ORIGIN=.*

PROMETHEUS_QUERY_TIMEOUT=2m
PROMETHEUS_QUERY_MAX_CONCURRENCY=20
PROMETHEUS_QUERY_MAX_SAMPLES=50000000
PROMETHEUS_QUERY_LOOKBACK_DELTA=5m

PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_SCRAPE_TIMEOUT=10s
PROMETHEUS_EVALUATION_INTERVAL=15s

PROMETHEUS_ALERTMANAGER_NOTIFICATION_QUEUE_CAPACITY=10000
PROMETHEUS_ALERTMANAGER_TIMEOUT=10s

PROMETHEUS_LOG_LEVEL=info
PROMETHEUS_LOG_FORMAT=json

PROMETHEUS_ENABLE_FEATURE_EXEMPLAR_STORAGE=true
PROMETHEUS_ENABLE_FEATURE_EXPAND_EXTERNAL_LABELS=true
PROMETHEUS_ENABLE_FEATURE_MEMORY_SNAPSHOT_ON_SHUTDOWN=true
PROMETHEUS_ENABLE_FEATURE_PROMQL_AT_MODIFIER=true
PROMETHEUS_ENABLE_FEATURE_PROMQL_NEGATIVE_OFFSET=true

PROMETHEUS_REMOTE_WRITE_ENABLED=false
PROMETHEUS_REMOTE_READ_ENABLED=false

PROMETHEUS_TSDB_MIN_BLOCK_DURATION=2h
PROMETHEUS_TSDB_MAX_BLOCK_DURATION=36h
PROMETHEUS_TSDB_ALLOW_OVERLAPPING_BLOCKS=false

PROMETHEUS_RULES_ALERT_FOR_OUTAGE_TOLERANCE=1h
PROMETHEUS_RULES_ALERT_FOR_GRACE_PERIOD=10m
PROMETHEUS_RULES_ALERT_RESEND_DELAY=1m

PROMETHEUS_GLOBAL_EXTERNAL_LABELS_ENVIRONMENT=development
PROMETHEUS_GLOBAL_EXTERNAL_LABELS_CLUSTER=initstack
PROMETHEUS_GLOBAL_EXTERNAL_LABELS_REGION=local

PROMETHEUS_SECURITY_BASIC_AUTH_ENABLED=false
PROMETHEUS_SECURITY_BASIC_AUTH_USERNAME=
PROMETHEUS_SECURITY_BASIC_AUTH_PASSWORD=

PROMETHEUS_METRICS_PATH=/metrics
PROMETHEUS_HEALTH_CHECK_PATH=/-/healthy
PROMETHEUS_READY_CHECK_PATH=/-/ready
PROMETHEUS_RELOAD_CONFIG_PATH=/-/reload

PROMETHEUS_HOST=0.0.0.0
PROMETHEUS_PORT=9090

CONSUL_EXPORTER_URL=http://initstack-consul-exporter-service:9107
REDIS_EXPORTER_URL=http://initstack-redis-exporter-service:9121
POSTGRESQL_EXPORTER_URL=http://initstack-postgresql-exporter-service:9187
ELASTICSEARCH_EXPORTER_URL=http://initstack-elasticsearch-exporter-service:9114
RABBITMQ_EXPORTER_URL=http://initstack-rabbitmq-service:15692
HAPROXY_STATS_URL=http://initstack-haproxy-service:8404
